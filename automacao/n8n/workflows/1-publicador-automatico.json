    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const d = $('Escolher post de agora').item.json;\nconst url = $env.MIDIA_BASE_URL + '/pub/' + encodeURIComponent(d.arquivo);\n\nlet q;\nif (d.carrossel) {\n  q = d.video\n    ? { media_type: 'VIDEO', video_url: url, is_carousel_item: true }\n    : { image_url: url, is_carousel_item: true };\n} else if (d.media_type === 'STORIES') {\n  q = d.video\n    ? { media_type: 'STORIES', video_url: url }\n    : { media_type: 'STORIES', image_url: url };\n} else if (d.media_type === 'REELS') {\n  q = { media_type: 'REELS', video_url: url, caption: d.legenda, share_to_feed: true };\n} else {\n  q = { image_url: url, caption: d.legenda };\n}\nq.access_token = $env.IG_TOKEN;\n\nreturn { json: { ...d, url, ig_query: q } };"
      },
