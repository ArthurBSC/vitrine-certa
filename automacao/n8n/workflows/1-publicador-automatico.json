        "jsCode": "const ids = $input.all().map(i => i.json.id);\nconst base = $('Escolher post de agora').first().json;\nconst comum = {\n  linha_id: base.linha_id,\n  legenda: base.legenda,\n  produto: base.produto,\n  data: base.data,\n  hora: base.hora,\n  tipo: base.tipo,\n  carrossel: !!base.carrossel\n};\n\nif (!base.carrossel) {\n  return [{ json: { ...comum, creation_id: ids[0] } }];\n}\nreturn [{ json: { ...comum, children: ids.join(',') } }];"
      },
