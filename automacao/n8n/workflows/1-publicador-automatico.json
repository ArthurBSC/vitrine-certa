    {
      "parameters": {
        "jsCode": "const linhas = $input.all().map(i => i.json);\nconst tz = 'America/Sao_Paulo';\nconst agora = new Date(new Date().toLocaleString('en-US', { timeZone: tz }));\nconst p = n => String(n).padStart(2, '0');\nconst hoje = `${agora.getFullYear()}-${p(agora.getMonth() + 1)}-${p(agora.getDate())}`;\nconst hora = agora.getHours();\n\nconst alvo = linhas.find(l =>\n  String(l.data || '').trim().slice(0, 10) === hoje &&\n  parseInt(String(l.hora || '-1'), 10) === hora &&\n  String(l.status || '').toUpperCase() !== 'POSTADO'\n);\n\n// Nada marcado para esta hora: a execução simplesmente termina aqui.\nif (!alvo) return [];\n\nconst arquivos = String(alvo.arquivo || '').split('|').map(s => s.trim()).filter(Boolean);\nif (!arquivos.length) throw new Error('Linha sem arquivo: ' + JSON.stringify(alvo));\n\nconst story = String(alvo.tipo || '').toLowerCase().startsWith('story');\nconst legenda = [alvo.legenda, alvo.link ? '🔗 ' + alvo.link : '', alvo.hashtags]\n  .filter(Boolean).join('\\n\\n');\n\nreturn arquivos.map((arquivo, i) => {\n  const video = /\\.(mp4|mov)$/i.test(arquivo);\n  return {\n    json: {\n      linha_id: alvo.id,\n      arquivo,\n      total: arquivos.length,\n      indice: i,\n      carrossel: arquivos.length > 1,\n      story,\n      video,\n      media_type: story ? 'STORIES' : (video ? 'REELS' : 'IMAGE'),\n      legenda,\n      produto: alvo.produto,\n      link: alvo.link,\n      data: alvo.data,\n      hora: alvo.hora,\n      tipo: alvo.tipo\n    }\n  };\n});"
      },
