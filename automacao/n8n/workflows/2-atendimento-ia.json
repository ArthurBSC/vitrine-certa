              }
            },
            {
              "id": "c-token",
              "leftValue": "={{ $json.query && $json.query['hub.verify_token'] ? $json.query['hub.verify_token'] : '' }}",
              "rightValue": "={{ $env.META_VERIFY_TOKEN }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "if-verif",
      "name": "É a verificação da Meta?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -480,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.query['hub.challenge'] }}",
        "options": {}
      },
      "id": "resp-chal",
      "name": "Devolver o challenge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        -260,
        -160
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "EVENT_RECEIVED",
        "options": {}
      },
      "id": "resp-ack",
      "name": "Responder 200 na hora",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        -260,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $('Entrada da Meta').first().json.body || {};\nconst out = [];\n\nfor (const entry of body.entry || []) {\n  // Comentários\n  for (const ch of entry.changes || []) {\n    const v = ch.value || {};\n    if (ch.field === 'comments' && v.id) {\n      out.push({ json: {\n        tipo: 'comentario',\n        comment_id: v.id,\n        texto: v.text || '',\n        autor: (v.from && v.from.username) || '',\n        autor_id: (v.from && v.from.id) || '',\n        media_id: (v.media && v.media.id) || ''\n      } });\n    }\n  }\n  // Directs\n  for (const m of entry.messaging || []) {\n    if (m.message && m.message.text && !m.message.is_echo) {\n      out.push({ json: {\n        tipo: 'dm',\n        sender_id: m.sender && m.sender.id,\n        texto: m.message.text,\n        autor: '',\n        autor_id: (m.sender && m.sender.id) || ''\n      } });\n    }\n  }\n}\n\n// Não responde a si mesmo\nreturn out.filter(o => String(o.json.autor_id) !== String($env.IG_USER_ID || ''));"
      },
      "id": "norm",
      "name": "Normalizar evento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -40,
        120
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.tipo === 'comentario' ? ('Comentário de @' + $json.autor + ': ' + $json.texto) : ('Direct: ' + $json.texto) }}",
        "options": {
          "systemMessage": "Você é o atendimento da Vitrine Certa (@vitrinecertaooficial), uma vitrine de achadinhos da Shopee.\n\nComo responder:\n- Português do Brasil, simpático, direto, no máximo 2 frases curtas. Pode usar 1 emoji.\n- SEMPRE use a ferramenta catalogo_vitrine antes de falar de qualquer produto. Nunca invente nome, preço ou link.\n- Quando achar o produto, responda com o nome curto e o link de afiliado exatamente como vem da ferramenta.\n- As legendas dos posts trazem uma chamada do tipo \"Comenta PARAFUSADEIRA que eu te mando o link no direct\". Quando o comentario ou o direct for so uma palavra em maiusculas (ou quase so isso), trate essa palavra como o nome do produto: busque no catalogo_vitrine por ela e responda com o produto e o link. Nao peca para a pessoa repetir nem pergunte o que ela quer.\n- O link vai sempre pelo direct, nunca na resposta publica do comentario. Prometemos \"mando no direct\" na legenda, entao cumpra isso.\n- Se não achar nada parecido, diga que vai verificar e convide a pessoa a ver a vitrine completa: {{ $env.VITRINE_URL }}\n- Pergunta sobre entrega, pagamento, troca ou rastreio: explique que a compra e o suporte são feitos dentro da Shopee, pelo app.\n- Nunca prometa prazo, desconto, frete grátis ou devolução.\n- Nunca peça CPF, endereço, telefone, e-mail, foto de documento ou dado de cartão. Se a pessoa mandar, não repita o dado.\n- Se for elogio, agradeça em uma frase. Se for ofensa ou spam, responda apenas com um agradecimento neutro.\n- Se perguntarem se você é um robô, assuma que é um atendimento automático da Vitrine Certa.\n- Somos afiliados: ganhamos comissão da Shopee quando alguém compra pelo nosso link. Se perguntarem, diga isso sem rodeio.\n\nResponda apenas com o texto da resposta, sem aspas e sem assinatura."
        }
      },
